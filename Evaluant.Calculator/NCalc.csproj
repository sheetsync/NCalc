<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net35;netstandard2.0</TargetFrameworks>
    <AssemblyName>NCalc</AssemblyName>
    <RootNamespace>NCalc</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Version>2.0.0</Version>
    <PackageId>NCalc</PackageId>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Authors>Sebastien Ros</Authors>
    <Description>NCalc is a mathematical expressions evaluator in .NET.</Description>
    <SignAssembly Condition="'$(NCalcStrongNameKeyFile)' != ''">true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="'$(NCalcStrongNameKeyFile)' != ''">$(NCalcStrongNameKeyFile)</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antlr3.Runtime" Version="3.5.1" PrivateAssets="all" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.45" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net35'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
